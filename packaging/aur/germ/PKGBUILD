# Maintainer: Zach Monroe <zmonroe1995@gmail.com>
# Builds germ from source. For the prebuilt binary, see germ-bin.
pkgname=germ
pkgver=0.1.0
pkgrel=1
pkgdesc="Fast GPU terminal with built-in tmux, coding-agent tools, and session sharing"
arch=('x86_64' 'aarch64')
url="https://github.com/zach-monroe/germ"
license=('MIT')
depends=('glibc' 'libglvnd' 'libx11' 'libxrandr' 'libxinerama' 'libxcursor' 'libxi' 'libxxf86vm'
         'fontconfig' 'tmux')
makedepends=('go' 'git' 'mesa')
optdepends=('xclip: X11 primary selection and pasting images'
            'wl-clipboard: pasting images on Wayland'
            'libnotify: desktop notifications'
            'git: germ agent worktrees'
            'ttf-jetbrains-mono-nerd: a good default font')
provides=('germ')
conflicts=('germ-bin')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "germ-$pkgver"
  export CGO_CPPFLAGS="$CPPFLAGS" CGO_CFLAGS="$CFLAGS" CGO_CXXFLAGS="$CXXFLAGS" CGO_LDFLAGS="$LDFLAGS"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
  go build -ldflags "-linkmode=external -X main.version=v$pkgver" -o germ ./cmd/germ
  CGO_ENABLED=0 GOFLAGS="-trimpath -mod=readonly -modcacherw" go build -o germ-relay ./cmd/germ-relay
}

check() {
  cd "germ-$pkgver"
  go test ./internal/...
}

package() {
  cd "germ-$pkgver"
  install -Dm755 germ "$pkgdir/usr/bin/germ"
  install -Dm755 germ-relay "$pkgdir/usr/bin/germ-relay"
  install -Dm644 packaging/germ.desktop "$pkgdir/usr/share/applications/germ.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/germ/README.md"
  install -Dm644 config.example.toml "$pkgdir/usr/share/doc/germ/config.example.toml"
}
