# Maintainer: Zach Monroe <zmonroe1995@gmail.com>
pkgname=germ-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Fast GPU terminal with built-in tmux, coding-agent tools, and session sharing (prebuilt)"
arch=('x86_64' 'aarch64')
url="https://github.com/zach-monroe/germ"
license=('MIT')
depends=('glibc' 'libglvnd' 'libx11' 'libxrandr' 'libxinerama' 'libxcursor' 'libxi' 'libxxf86vm'
         'fontconfig' 'tmux')
optdepends=('xclip: X11 primary selection and pasting images'
            'wl-clipboard: pasting images on Wayland'
            'libnotify: desktop notifications'
            'git: germ agent worktrees'
            'ttf-jetbrains-mono-nerd: a good default font')
provides=('germ')
conflicts=('germ')
source_x86_64=("germ-$pkgver-x86_64.tar.gz::$url/releases/download/v$pkgver/germ-linux-x86_64.tar.gz")
source_aarch64=("germ-$pkgver-aarch64.tar.gz::$url/releases/download/v$pkgver/germ-linux-aarch64.tar.gz")
sha256sums_x86_64=('@SHA_X86_64@')
sha256sums_aarch64=('@SHA_AARCH64@')

package() {
  cd "germ-linux-$CARCH"
  install -Dm755 germ "$pkgdir/usr/bin/germ"
  install -Dm755 germ-relay "$pkgdir/usr/bin/germ-relay"
  install -Dm644 germ.desktop "$pkgdir/usr/share/applications/germ.desktop"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/germ/README.md"
  install -Dm644 config.example.toml "$pkgdir/usr/share/doc/germ/config.example.toml"
}
